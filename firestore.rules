rules_version = '2';
// Doc2Proto 코멘트 — 권한 없음: 로그인 없이 누구나 읽고 쓸 수 있다 (내용 길이만 확인)
service cloud.firestore {
  match /databases/{database}/documents {
    function okBody(d) { return d.body is string && d.body.size() > 0 && d.body.size() <= 2000; }
    match /threads/{id} {
      allow read: if true;
      allow create: if okBody(request.resource.data);
      allow update, delete: if true;
      match /replies/{rid} {
        allow read: if true;
        allow create: if okBody(request.resource.data);
        allow delete: if true;
      }
    }
  }
}
